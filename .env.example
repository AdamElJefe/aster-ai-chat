# Copy to .env for local development. DEV VALUES ONLY: never reuse in staging/prod.
# Staging/prod secrets come from the secret manager, never from files in the repo.

APP_ENV=dev
DATABASE_URL=postgresql://aster_app:aster_app_dev@localhost:5432/aster
DATABASE_OWNER_URL=postgresql://aster_owner:aster_owner_dev@localhost:5432/aster
REDIS_URL=redis://localhost:6379/0

# Adapters (mocks are refused outside dev/test)
AUTH_PROVIDER=dev_auth
AGE_PROVIDER=mock_age
REGION_RESOLVER=header_region
TEXT_PROVIDER=mock_text
APPROVED_ADAPTERS=

# Generate with: make secrets   (writes fresh random values into .env)
DATA_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
ACTIVE_DATA_KEY_ID=k1
SESSION_PEPPER=REPLACE_ME
MOCK_AGE_SIGNING_SECRET=REPLACE_ME

ALLOWED_REGIONS=US-TEST
COOKIE_SECURE=false
MOCK_TOKEN_DELAY_MS=25

# Only when TEXT_PROVIDER=openai_compat (keep the model server on a private network)
TEXT_BASE_URL=
TEXT_API_KEY=
TEXT_MODEL_ID=mock-companion-v0
